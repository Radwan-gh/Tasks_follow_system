generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BoardRole {
  OWNER
  MEMBER
  /// Read-only: no move/create/comment/assign — see `BoardsService.assertMembership`.
  VIEWER
}

enum UserRole {
  USER
  ADMIN
}

enum CardActivityType {
  CREATED
  MOVED
  RENAMED
  DESCRIPTION_UPDATED
  DUE_DATE_CHANGED
  ARCHIVED
  UNARCHIVED
  ASSIGNED
  UNASSIGNED
}

/// Semantic status of a list, set when a board is seeded from a built-in
/// template. Lets features (esp. reports) identify the terminal `DONE`/
/// `CLOSED` statuses without depending on the list's renameable name. Null
/// for manual lists. `CLOSED` is a new terminal status *after* `DONE` (see
/// `isCompleted()` in `common/util/completed.util.ts`, which treats
/// `DONE`/`CLOSED` as "counts as done" everywhere reports/my-tasks care).
/// `REVIEW` is retired from the current board template but stays valid for
/// lists created before this change.
enum ListStatusCategory {
  NEW
  READY
  IN_PROGRESS
  REVIEW
  DONE
  CLOSED
}

enum CardPriority {
  LOW
  NORMAL
  URGENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  /// Set by `POST /admin/users/:id/reset-password`; cleared the next time this
  /// user successfully calls `POST /auth/change-password`. Forces the
  /// "عيّن كلمة مرور جديدة" screen on first login with a temporary password.
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())

  /// Three notification-category toggles (assignment/comments,
  /// due-dates/overdue, my-card-moved-to-closed), all default true. Shape
  /// validated by `NotificationPrefsSchema` in `packages/types` — kept as a
  /// loose Json column rather than three booleans so a fourth toggle never
  /// needs a migration.
  notificationPrefs Json?

  refreshTokens  RefreshToken[]
  boardMemberships BoardMember[]
  cardMemberships  CardMember[]
  createdCards   Card[]         @relation("CardCreator")
  ownedBoards    Board[]        @relation("BoardOwner")
  cardActivities CardActivity[] @relation("CardActivityActor")
  cardAssignments    CardAssignee[]
  createdSubtasks    Subtask[]         @relation("SubtaskCreator")
  subtaskAssignments SubtaskAssignee[]
  comments           Comment[]
  attachments        Attachment[]
  notifications      Notification[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Board {
  id          String    @id @default(cuid())
  name        String
  description String?
  /// Optional target completion date for the whole board. Never shown when
  /// null — no placeholder text, no empty chip (`v2-new-style.md` §1).
  dueDate     DateTime?
  ownerId     String
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner     User           @relation("BoardOwner", fields: [ownerId], references: [id])
  members   BoardMember[]
  lists     List[]
  templates Template[]

  @@index([ownerId])
}

model BoardMember {
  id       String    @id @default(cuid())
  boardId  String
  userId   String
  role     BoardRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

model List {
  id             String              @id @default(cuid())
  boardId        String
  name           String
  position       String
  isArchived     Boolean             @default(false)
  statusCategory ListStatusCategory?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId, position])
}

model Card {
  id          String    @id @default(cuid())
  listId      String
  boardId     String
  title       String
  description String?
  position    String
  dueDate     DateTime?
  isArchived  Boolean   @default(false)
  // When false the card inherits board access (all board members see it).
  // When true only rows in `members` (plus the board owner and creator) can
  // see/open/edit it — a private allow-list.
  isRestricted Boolean  @default(false)
  priority     CardPriority @default(NORMAL)
  /// Amount + optional free-text note (invoice #, vendor name). Single
  /// currency, written as a free-text symbol in board/account settings —
  /// see `v2-new-style.md` §7.3/3c-1. Never shown on the card face.
  costAmount   Decimal?     @db.Decimal(12, 2)
  costNote     String?
  /// Recurrence rule as `{ freq: "DAILY"|"WEEKLY"|"MONTHLY", weekdays?:
  /// number[], dayOfMonth?: number } | null`. On move into a `CLOSED` list,
  /// `CardsService` reads this to spawn the next instance — see
  /// `design-prompt-group-3.md` §3a-3/§9.
  recurrence   Json?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  list        List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdBy   User           @relation("CardCreator", fields: [createdById], references: [id])
  activities  CardActivity[]
  members     CardMember[]
  assignees   CardAssignee[]
  subtasks    Subtask[]
  comments    Comment[]
  attachments Attachment[]

  @@index([listId, position])
  @@index([boardId, isArchived])
}

/// A text comment on a card, merged with `CardActivity` into one timeline by
/// the client (`GET /cards/:id/comments` alongside `GET /cards/:id/history`)
/// rather than forced into `CardActivitySchema`'s shape. Deletable by its
/// author only.
model Comment {
  id        String   @id @default(cuid())
  cardId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  card   Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([cardId, createdAt])
}

/// An image attached to a card. Files live on local disk under
/// `apps/api/uploads/`; this row is the metadata + ownership record. Limits
/// (images only, ≤10/card, ≤5MB/file) are enforced in `AttachmentsService`,
/// not the schema.
model Attachment {
  id         String   @id @default(cuid())
  cardId     String
  uploaderId String
  filename   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  card     Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id])

  @@index([cardId, createdAt])
}

/// In-app notification (assignment, due-soon, overdue, comment on a card
/// I'm on, my card moved to «انتهى»). No OS push — this is the in-app bell/
/// center only (`GET /notifications`); `payload` carries the type-specific
/// bits the client needs to render/route without a second fetch.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  cardId    String?
  boardId   String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// A board-owner-managed task template: picking it prefills title/
/// description/subtasks on the add-task screen. Distinct from
/// `board-templates.ts`'s `TASK_WORKFLOW_TEMPLATE`, which seeds a *board's
/// lists*, not a card.
model Template {
  id             String   @id @default(cuid())
  boardId        String
  name           String
  titlePattern   String
  description    String?
  subtaskTitles  String[]
  createdAt      DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

/// Append-only audit trail for a card ("task"): who created it, and who
/// changed its status (list), title, description, due date, or archived
/// state — and when. Rows are never mutated, only inserted, so the ordered
/// stream is the card's full history. Deleting a card cascades its history.
model CardActivity {
  id        String           @id @default(cuid())
  cardId    String
  boardId   String
  actorId   String
  type      CardActivityType
  fromValue String?
  toValue   String?
  createdAt DateTime         @default(now())

  card  Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  actor User @relation("CardActivityActor", fields: [actorId], references: [id])

  @@index([cardId, createdAt])
}

model CardMember {
  id      String   @id @default(cuid())
  cardId  String
  userId  String
  addedAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@index([userId])
}

/// People a card ("task") is assigned to. A card can be assigned to several
/// board members. Distinct from `CardMember` (an access allow-list) — this is
/// assignment/ownership of the work.
model CardAssignee {
  id         String   @id @default(cuid())
  cardId     String
  userId     String
  assignedAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@index([userId])
}

/// A sub-task belonging to a card, ordered within it by a fractional-index
/// `position` (same scheme as lists/cards) and checkable via `isDone`.
model Subtask {
  id          String   @id @default(cuid())
  cardId      String
  title       String
  isDone      Boolean  @default(false)
  position    String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  card      Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdBy User              @relation("SubtaskCreator", fields: [createdById], references: [id])
  assignees SubtaskAssignee[]

  @@index([cardId, position])
}

/// People a sub-task is assigned to (several board members allowed).
model SubtaskAssignee {
  id         String   @id @default(cuid())
  subtaskId  String
  userId     String
  assignedAt DateTime @default(now())

  subtask Subtask @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subtaskId, userId])
  @@index([userId])
}
