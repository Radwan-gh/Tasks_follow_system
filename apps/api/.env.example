DATABASE_URL="postgresql://kanban:kanban@localhost:5432/kanban?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
PORT=3000

# Remote MCP server (docs/15-mcp-server.md): the public base URL Claude reaches
# this API at. It becomes the OAuth issuer and the MCP endpoint is <it>/mcp.
# Optional: on Railway the injected RAILWAY_PUBLIC_DOMAIN is used when unset,
# and locally it falls back to http://localhost:$PORT. Must be https otherwise.
# PUBLIC_API_URL="https://api-production-b27a.up.railway.app"

# The users' time zone (IANA name). Repeating cards count weekdays and days of
# the month on this calendar, not the server's (Railway runs in UTC) — see
# docs/14-notifications-comments-attachments.md. Defaults to Asia/Damascus.
# APP_TIME_ZONE="Asia/Damascus"

# Firebase Cloud Messaging — OS push notifications for apps/mobile
# (docs/14-notifications-comments-attachments.md). Generate the key at:
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Set EITHER of these; leave both unset and push is simply disabled (the API
# logs a warning at startup and the in-app notification centre still works).
#   FIREBASE_SERVICE_ACCOUNT: the service-account JSON inline, on one line.
#   FIREBASE_SERVICE_ACCOUNT_PATH: a path to that JSON file (easier in dev).
# This key grants send access to your Firebase project — never commit it.
# FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
# FIREBASE_SERVICE_ACCOUNT='{"project_id":"...","private_key":"...","client_email":"..."}'

# Card attachment storage (docs/14-notifications-comments-attachments.md).
# Leave unset locally: files go to apps/api/uploads (or UPLOADS_DIR). In
# production these MUST point at a Railway bucket — the container disk is wiped
# on every deploy (see DEPLOY.md). Set AWS_S3_FORCE_PATH_STYLE=true only for an
# older bucket whose Credentials tab says it needs path-style URLs.
# AWS_ENDPOINT_URL=
# AWS_S3_BUCKET_NAME=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# UPLOADS_DIR=
