DATABASE_URL="postgresql://kanban:kanban@localhost:5432/kanban?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
PORT=3000

# Self-hosted expo-updates OTA server (apps/mobile publishes here via
# `pnpm --filter @app/mobile publish-update`; see docs/12-mobile-app.md).
# EXPO_UPDATES_STORAGE_DIR: where published bundles are read from — must
#   match the destination `publish-update.mjs` copies into (defaults to
#   apps/api/update-bundles on both sides, so usually leave unset).
# EXPO_UPDATES_PUBLIC_URL: base URL phones use to reach this API, for
#   building asset URLs in the manifest. Leave unset in dev (the request's
#   own Host header is reused); set explicitly in production if the API
#   sits behind a reverse proxy that changes the host.
# EXPO_UPDATES_STORAGE_DIR="./update-bundles"
# EXPO_UPDATES_PUBLIC_URL="https://api.example.com"

# Firebase Cloud Messaging — OS push notifications for apps/mobile
# (docs/14-notifications-comments-attachments.md). Generate the key at:
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Set EITHER of these; leave both unset and push is simply disabled (the API
# logs a warning at startup and the in-app notification centre still works).
#   FIREBASE_SERVICE_ACCOUNT: the service-account JSON inline, on one line.
#   FIREBASE_SERVICE_ACCOUNT_PATH: a path to that JSON file (easier in dev).
# This key grants send access to your Firebase project — never commit it.
# FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
# FIREBASE_SERVICE_ACCOUNT='{"project_id":"...","private_key":"...","client_email":"..."}'
