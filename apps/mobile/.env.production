# Production. Picked up automatically whenever NODE_ENV=production — that is
# `gradlew assembleRelease` (the distributable APK), `expo export`
# (`bundle:check`), and OTA publishing with `eoas publish`.
#
# This is the URL baked into any APK you hand to someone else, so it must be
# reachable from their device — never a LAN address.
#
# CI overrides this with the `EXPO_PUBLIC_API_URL` Actions Variable when one is
# set (a real process env var beats every .env file); this line is the fallback
# so a build can no longer ship pointed at nothing.
EXPO_PUBLIC_API_URL="https://api-production-b27a.up.railway.app"
