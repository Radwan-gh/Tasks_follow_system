{
  "expo": {
    "name": "متابعة المهام",
    "slug": "tasks-follow-system",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tasksfollow",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tasksfollow.app"
    },
    "android": {
      "package": "com.tasksfollow.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F6F3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6F3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج التطبيق الوصول إلى معرض الصور لإرفاق صورة بالمهمة.",
          "cameraPermission": "يحتاج التطبيق الوصول إلى الكاميرا لالتقاط صورة وإرفاقها بالمهمة."
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#4A6FD4"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://ota-production-6c85.up.railway.app/manifest",
      "codeSigningCertificate": "./certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      },
      "requestHeaders": {
        "expo-app-id": "27127625-df3c-463d-89f6-853045f4c392",
        "expo-channel-name": "production"
      }
    }
  }
}
