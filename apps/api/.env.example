DATABASE_URL="postgresql://kanban:kanban@localhost:5432/kanban?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
PORT=3000

# Self-hosted expo-updates OTA server (apps/mobile publishes here via
# `pnpm --filter @app/mobile publish-update`; see docs/12-mobile-app.md).
# EXPO_UPDATES_STORAGE_DIR: where published bundles are read from — must
#   match the destination `publish-update.mjs` copies into (defaults to
#   apps/api/update-bundles on both sides, so usually leave unset).
# EXPO_UPDATES_PUBLIC_URL: base URL phones use to reach this API, for
#   building asset URLs in the manifest. Leave unset in dev (the request's
#   own Host header is reused); set explicitly in production if the API
#   sits behind a reverse proxy that changes the host.
# EXPO_UPDATES_STORAGE_DIR="./update-bundles"
# EXPO_UPDATES_PUBLIC_URL="https://api.example.com"
