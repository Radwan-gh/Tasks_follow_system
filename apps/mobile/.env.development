# Local development. Picked up automatically whenever NODE_ENV=development —
# that is `expo start` (Metro, Expo Go, dev client) and any debug build.
#
# Committed on purpose: there are no secrets here, only where the API happens to
# live on a dev machine. `EXPO_PUBLIC_` means the value is inlined into the JS
# bundle at build time, so never put a secret in any of these files.
#
# 10.0.2.2 is the Android emulator's alias for the host machine's localhost.
# A PHYSICAL device cannot reach it — it needs your machine's LAN IP. Put that
# in `.env.development.local` (gitignored, and it wins over this file) rather
# than editing this one:
#
#   EXPO_PUBLIC_API_URL="http://192.168.1.10:3000"
#
# Use `.env.development.local`, not `.env.local`: the latter would also override
# production builds, which is exactly the mistake this split exists to prevent.
EXPO_PUBLIC_API_URL="http://10.0.2.2:3000"
